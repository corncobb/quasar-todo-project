# Firebase web app config (Firebase console -> Project settings -> Your apps)
# Copy this file to .env and fill in real values for local development.
# For Vercel, set the same keys under Project Settings -> Environment Variables.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
